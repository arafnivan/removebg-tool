# Copy to .env.local and adjust before building.

# Public repository this deployment is built from. Shown on the page as the
# "Source code" link, which the AGPL-3.0 requires for a public deployment.
VITE_SOURCE_URL=https://github.com/arafnivan/removebg-tool

# The main ImageDoctor website, linked from the header and footer.
VITE_MAIN_SITE_URL=https://imgdoctor.vercel.app

# Public URL of this deployment, used for the canonical link, Open Graph
# image and structured data in index.html.
VITE_SITE_URL=https://removebg-imgdoctor.vercel.app
